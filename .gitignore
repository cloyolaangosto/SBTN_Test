# ---- IGNORE ------
# Folders with large/unzipped data
data/*
outputs/
archives/
# Ignore the paper working folder, but keep the curated Claude analysis
# (notebooks, scripts and lightweight CSV/PNG outputs) under version control.
# The outputs/ re-include is needed because the global `outputs/` rule above
# would otherwise also ignore paper/claude_analysis/outputs/.
paper/*
!paper/claude_analysis/
!paper/claude_analysis/outputs/

# Geospatial rasters
*.tif
*.tiff
*.vrt
*.nc
*.hdf
*.h5
*.img
*.bil

# Archives (don’t track these in Git)
*.zip
*.7z
*.rar

# Logs
*.log

# Misc OS/editor cruft
.DS_Store
Thumbs.db
.ipynb_checkpoints/
*.tmp
*.egg-info/

# Local env/secrets
.env
.venv/
*.pem

# Local notes (optional)
cloudfare.txt
purge_path.txt

# ---- Python ----
__pycache__/
*.py[cod]
*.so

# ---- Virtual environments ----
.venv/
env/
venv/
ENV/

# ---- Build artifacts ----
*.egg-info/
*.eggs/
build/
dist/

# ---- Jupyter ----
.ipynb_checkpoints/
*.ipynb_tmp
MD_Cheat_Sheet.ipynb

# ---- IDE/editor cruft ----
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/

# ---- KEEP EXCEPTIONS ------

# Keep empty data/ visible in the repo
!data/.gitkeep
!archives/.gitkeep
!examples/soc_ex_data/.gitkeep
!examples/soc_ex_output/.gitkeep

# Lightweight data and example data
!data/crops/
!data/templates/
!data/crops/spam2020V2r0_global_yield/spam2020_V2r0_global_Y_MAIZ_A.tif
!data/crops/spam2020V2r0_global_yield/spam2020_V2r0_global_Y_MAIZ_I.tif
!data/crops/spam2020V2r0_global_yield/spam2020_V2r0_global_Y_MAIZ_R.tif
!archives/se_rlsk.png
data/crops/spam2020V2r0_global_Y_TA.csv
data/crops/SPAM/spam2020V2r0_global_Y_TA.csv
data/crops/FAO_GAEZ/FAO_GAEZ_croplist.csv
